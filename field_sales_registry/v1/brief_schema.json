{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novostroy.local/field-sales-registry/v1/brief_schema.json",
  "title": "External Field Sales Registry v1 compact brief",
  "type": "object",
  "required": ["schema_version", "scenario", "object_name", "fresh_mcp", "fields", "combinations", "constraints", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "scenario": {"$ref": "#/$defs/scenario"},
    "object_name": {"type": ["string", "null"], "maxLength": 240},
    "fresh_mcp": {"type": "boolean"},
    "fields": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/field"}},
    "combinations": {"type": "array", "items": {"$ref": "#/$defs/combination"}},
    "constraints": {
      "type": "object",
      "required": ["facts_are_canonical", "no_new_facts", "registry_version"],
      "additionalProperties": false,
      "properties": {
        "facts_are_canonical": {"const": true},
        "no_new_facts": {"const": true},
        "registry_version": {"const": "v1"}
      }
    },
    "diagnostics": {
      "type": "object",
      "required": ["unknown_field_ids", "omitted_field_ids"],
      "additionalProperties": false,
      "properties": {
        "unknown_field_ids": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 80, "pattern": "^[A-Za-z0-9_.-]+$"}},
        "omitted_field_ids": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/omission"}}
      }
    }
  },
  "$defs": {
    "scenario": {"enum": ["family", "commute", "budget", "comfort", "safety", "investment", "parking", "readiness", "general"]},
    "strength": {"enum": ["strong", "supporting", "neutral", "weak"]},
    "primitive": {"type": ["string", "number", "boolean"], "maxLength": 240},
    "field": {
      "type": "object",
      "required": ["field_id", "label", "value", "literal_meaning", "strength", "required_evidence", "forbidden_claims", "rendering_rules"],
      "additionalProperties": false,
      "properties": {
        "field_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 240},
        "value": {"oneOf": [{"$ref": "#/$defs/primitive"}, {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/primitive"}}]},
        "literal_meaning": {"type": "string", "minLength": 1},
        "allowed_benefit": {"type": "string", "minLength": 1},
        "strength": {"$ref": "#/$defs/strength"},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rendering_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "combination": {
      "type": "object",
      "required": ["id", "client_meaning", "required_cards", "required_evidence", "safe_phrasing", "forbidden_leap"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "client_meaning": {"type": "string", "minLength": 1},
        "required_cards": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "safe_phrasing": {"type": "string", "minLength": 1},
        "forbidden_leap": {"type": "string", "minLength": 1}
      }
    },
    "omission": {
      "type": "object",
      "required": ["field_id", "reason"],
      "additionalProperties": false,
      "properties": {
        "field_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "reason": {"enum": ["missing", "stale_dynamic", "unsafe_value", "not_relevant", "limit"]}
      }
    }
  }
}
