# Copy to /home/neiro/novostroy-bot-v0/.env and fill secrets outside Git.
NMBOT_V0_INTERNAL_TOKEN=
NMBOT_V0_PORT=18080
NMBOT_V0_STATE_PATH=/home/neiro/novostroy-bot-v0/data/state.json
NMBOT_V0_JOURNAL_PATH=/home/neiro/novostroy-bot-v0/logs/runtime.jsonl
# Required: set to the immutable V0 release ID before starting the unit.
NMBOT_V0_RELEASE_ID=
NMBOT_V0_GATEWAY_ENABLED=0
NMBOT_V0_GATEWAY_URL=
NMBOT_V0_TOTAL_TIMEOUT_SECONDS=20
