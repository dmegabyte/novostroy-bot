# Copy outside Git and set credential values in the process environment.
NMBOT_V2_INTERNAL_TOKEN=
NMBOT_V2_PORT=18082
NMBOT_V2_STATE_PATH=/home/neiro/novostroy-bot-v2/data/state.json
NMBOT_V2_JOURNAL_PATH=/home/neiro/novostroy-bot-v2/logs/runtime.jsonl
# Required immutable release identity; blank and placeholders are rejected.
NMBOT_V2_RELEASE_ID=
# Gateway settings. This file contains the credential variable name, never its value.
NMBOT_V2_GATEWAY_URL=https://gateway.example.invalid
NMBOT_V2_GATEWAY_TOKEN_ENV=NMBOT_V2_GATEWAY_TOKEN
NMBOT_V2_GATEWAY_REQUEST_TIMEOUT_SECONDS=25
# Optional; defaults to 1 when omitted.
NMBOT_V2_GATEWAY_POLL_INTERVAL_SECONDS=1
NMBOT_V2_PLANNER_MODEL=provider/planner-model
NMBOT_V2_PLANNER_TIMEOUT_SECONDS=10
# Optional V2 composition modes; only off, shadow, or publish are accepted.
NMBOT_V2_RESPONSE_COMPOSER_MODE=off
NMBOT_V2_MANAGER_REWRITER_MODE=off
