# PLACEHOLDER-only example for isolated client-production contour.
NMBOT_CONTOUR_PROFILE=client_production

JIVO_PROVIDER_ID=PLACEHOLDER_JIVO_PROVIDER_ID
JIVO_PROVIDER_TOKEN=PLACEHOLDER_JIVO_PROVIDER_TOKEN
NMBOT_API_TOKEN=PLACEHOLDER_NMBOT_API_TOKEN
NMBOT_N8N_BRIDGE_TOKEN=PLACEHOLDER_NMBOT_N8N_BRIDGE_TOKEN

NMBOT_API_HOST=127.0.0.1
NMBOT_API_PORT=8188
NMBOT_N8N_BRIDGE_HOST=0.0.0.0
NMBOT_N8N_BRIDGE_PORT=8193
NMBOT_BRIDGE_UPSTREAM=http://127.0.0.1:8188

NMBOT_API_STATE_FILE=/home/neiro/novostroy-bot-client-production/data/api_state.json
NMBOT_RUNTIME_VERSION_FILE=/home/neiro/novostroy-bot-client-production/data/runtime_selector.json
NMBOT_CALLBACK_OUTBOX_DIR=/home/neiro/novostroy-bot-client-production/data/callback_outbox
NMBOT_DIALOGUE_JOURNAL=/home/neiro/novostroy-bot-client-production/logs/dialogue_journal.jsonl
NMBOT_READABLE_DIALOGUE_JOURNAL=/home/neiro/novostroy-bot-client-production/logs/dialogue_readable.log
NMBOT_PLANNER_TRACE_FILE=/home/neiro/novostroy-bot-client-production/logs/planner_trace.jsonl
NMBOT_PLANNER_TRACE_DIR=/home/neiro/novostroy-bot-client-production/logs/planner_traces
NMBOT_BRIDGE_STRUCTURED_LOG=/home/neiro/novostroy-bot-client-production/logs/n8n_bridge_structured.jsonl
NMBOT_RELEASE_IDENTITY_FILE=/home/neiro/novostroy-bot-client-production/release_identity.json

NMBOT_V2_MANAGER_REWRITER_MODE=off
NMBOT_V3_MANAGER_REWRITER_MODE=publish

NMBOT_BRIDGE_STATUS_UPDATES_ENABLED=0
NMBOT_BRIDGE_STATUS_INTERVAL_SECONDS=3
NMBOT_BRIDGE_STATUS_TEMPLATES="Уже работаю над вашим запросом.|Проверяю нужную информацию.|Уточняю детали, чтобы ответить точнее.|Ещё немного — готовлю ответ."
NMBOT_BRIDGE_TIMEOUT_SECONDS=90
NMBOT_BRIDGE_HARD_TIMEOUT_SECONDS=600
NMBOT_BRIDGE_FALLBACK_TEXT="Запрос ещё обрабатывается, пожалуйста, не отправляйте его повторно. Я вернусь с вариантами в ближайшее время."
