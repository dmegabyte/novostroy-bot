# Copy to /home/neiro/novostroy-bot-v3/.env and fill secret values outside Git.
NMBOT_V3_INTERNAL_TOKEN=
NMBOT_V3_PORT=18083
NMBOT_V3_STATE_PATH=/home/neiro/novostroy-bot-v3/data/state.json
NMBOT_V3_JOURNAL_PATH=/home/neiro/novostroy-bot-v3/logs/runtime.jsonl
# Required: immutable V3 release ID. The service refuses blank or placeholder values.
NMBOT_V3_RELEASE_ID=
# Gateway configuration. Keep the credential values outside Git.
NMBOT_V3_GATEWAY_URL=https://gateway.example.invalid
# These name the environment variables that hold credentials; they are not credentials.
NMBOT_V3_GATEWAY_TOKEN_ENV=NMBOT_V3_GATEWAY_TOKEN
NMBOT_V3_PROVIDER_API_KEY_ENV=NMBOT_V3_PROVIDER_API_KEY
NMBOT_V3_PLANNER_MODEL=provider/planner-model
NMBOT_V3_EVIDENCE_MODEL=provider/evidence-model
NMBOT_V3_WRITER_MODEL=provider/writer-model
NMBOT_V3_GATEWAY_TIMEOUT_SECONDS=30
# Optional; defaults to 1 second when omitted.
NMBOT_V3_GATEWAY_POLL_INTERVAL_SECONDS=1
