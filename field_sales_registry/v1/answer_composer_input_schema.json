{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novostroy.local/field-sales-registry/v1/answer_composer_input_schema.json",
  "title": "External Field Sales Registry v1 Answer Composer input",
  "type": "object",
  "required": ["schema_version", "answer_goal", "cta_template", "brief"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "answer_goal": {"const": "present_selected"},
    "cta_template": {"type": "string", "minLength": 1, "maxLength": 240},
    "brief": {"$ref": "brief_schema.json"}
  }
}
