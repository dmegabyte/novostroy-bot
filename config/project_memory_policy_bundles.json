      "deny_rules": [
        "adaptive_behavior_disabled",
        "behavior_hints_disabled",
        "failed_invalid_stale_records_diagnostics_only",
        "no_runtime_prompt_model_provider_network_notebook_mempalace_changes",
        "no_raw_query_code_log_payload_transcript_label_secret_storage"
      ],
      "threshold_profile": {
        "status": "pilot_only_not_enforced",
        "max_hints": 5,
        "min_verifier_result": "not_enforced"
      }
    }
  ]
}
