{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmbot.local/schemas/v2_search_mcp_request.schema.json",
  "title": "NMBot V2 Search MCP executable request envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["search_goal", "constraints", "response_viewpoint", "base_viewpoint", "available_fact_fields", "count", "excluded_names", "search_mode", "current_option_names", "facts_needed"],
  "properties": {
    "search_goal": { "$ref": "#/$defs/searchGoal" },
    "constraints": { "$ref": "#/$defs/constraints" },
    "response_viewpoint": { "enum": ["investment", "rental", "family", "life", "financing"] },
    "base_viewpoint": { "anyOf": [{ "enum": ["investment", "rental", "family", "life"] }, { "type": "null" }] },
    "available_fact_fields": { "type": "array", "items": { "$ref": "#/$defs/factField" }, "uniqueItems": true },
    "count": { "type": "integer", "minimum": 1, "maximum": 5 },
    "ignored_preferences": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "excluded_names": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 120 }, "uniqueItems": true },
    "search_mode": { "enum": ["broad", "named_object", "current_options_fact_check"] },
    "current_option_names": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 120 }, "uniqueItems": true },
    "facts_needed": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "$defs": {
    "jsonValue": { "anyOf": [{ "type": ["string", "number", "integer", "boolean", "null"] }, { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } }, { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }] },
    "hardKey": { "enum": ["district", "location", "rooms", "max_price", "min_price", "ready", "finishing", "area_min_m2", "area_max_m2"] },
    "hardConstraints": { "type": "object", "propertyNames": { "$ref": "#/$defs/hardKey" }, "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
    "preferences": { "type": "object", "propertyNames": { "enum": ["format", "rooms_preference", "budget_preference", "location_preference", "infrastructure_preference", "transport_preference", "finance_preference", "sort_hint"] }, "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
    "constraints": { "type": "object", "additionalProperties": false, "required": ["requested_hard", "effective_hard", "preferences", "relaxation_audit"], "properties": { "requested_hard": { "$ref": "#/$defs/hardConstraints" }, "effective_hard": { "$ref": "#/$defs/hardConstraints" }, "preferences": { "$ref": "#/$defs/preferences" }, "relaxation_audit": { "type": "array", "maxItems": 3, "items": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" }, "properties": { "field": { "$ref": "#/$defs/hardKey" }, "from": { "$ref": "#/$defs/jsonValue" }, "to": { "$ref": "#/$defs/jsonValue" }, "reason_code": { "type": "string" } } } } } },
    "searchGoal": { "type": "object", "additionalProperties": false, "required": ["entity_type", "query_summary", "explicit_terms"], "properties": { "entity_type": { "type": "string", "minLength": 1 }, "query_summary": { "type": "string", "minLength": 1, "maxLength": 180 }, "explicit_terms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "entity_reference": { "type": "string", "minLength": 1, "maxLength": 100 }, "lookup_mode": { "const": "exact_named_object" }, "current_option_names": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 120 }, "uniqueItems": true }, "facts_needed": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "scope_policy": { "const": "exact_current_option_names_only" } } },
    "factField": { "type": "string", "enum": ["id", "name", "alias", "type_object", "district", "location_id", "location", "street", "new_building_class", "building_type", "rooms", "min_price", "max_price", "price1", "price2", "price3", "price4", "price_s", "price_n", "price_square", "square_min", "square_max", "floors_total", "delivered", "built_year", "ready_quarter", "ready", "status", "lat", "long", "distance_from_mkad", "rating", "count_ads", "object_site", "developer", "developer_description", "state", "link", "ipoteka", "fz214", "parking", "elevator", "concierge", "garage", "balcony", "loggia", "territory", "security", "yard_without_cars", "children_ground", "sports_ground", "heating_type", "conditioning_type", "finishing", "apartments", "taunhouse", "site_url", "utility_fee", "park_near", "water_near", "trade_in", "is_investment", "school", "kindergarten", "ddu_escrow", "ads_type_list", "total_area", "property_metro", "metro", "metro_line", "property_railway", "highway_name", "location_2.ecology_rating", "ecology_rating", "house", "ads", "ads.fullprice", "ads.price", "ads.area", "ads.rooms", "ads.renovation", "ads.status", "ads.apart", "ads_add.stat_price", "apartment_types", "mortgage_calc", "mortgage", "discount", "payment_by_installments", "apartment_inventory", "available_apartments", "flats_available", "egrn_top_novos", "egrn_contracts", "counter_novos", "novos.min_price", "novos.max_price", "infrastructure", "house.finishing_list"] }
  }
}
