[Unit]
Description=NMBOT dialogue Google Sheets hourly export
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/neiro/novostroy-bot
EnvironmentFile=/home/neiro/novostroy-bot/.env
ExecStart=/usr/bin/python3 /home/neiro/novostroy-bot/scripts/nmbot_dialogue_sheet_exporter.py --write --verify-readback
UMask=0077
NoNewPrivileges=true
