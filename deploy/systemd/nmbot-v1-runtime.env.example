# Copy to /home/neiro/novostroy-bot-v1/.env and fill secrets outside Git.
NMBOT_V1_INTERNAL_TOKEN=
NMBOT_V1_PORT=18081
NMBOT_V1_STATE_PATH=/home/neiro/novostroy-bot-v1/data/state.json
NMBOT_V1_JOURNAL_PATH=/home/neiro/novostroy-bot-v1/logs/runtime.jsonl
# Required: set to the immutable V1 release ID before starting the unit.
NMBOT_V1_RELEASE_ID=
NMBOT_V1_GATEWAY_ENABLED=0
NMBOT_V1_ONE_MODEL_GPT55_MODE=off
OVERMIND_URL=http://127.0.0.1:8080
