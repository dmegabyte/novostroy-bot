{
  "schema": "policy_bundle.v1",
  "policies": [
    {
      "project_id": "nmbot",
      "policy_version": "nmbot-passive-v1",
      "policy_delta": "passive_local_outcome_store_only",
      "owner_tbd": "TBD",
      "effective_from": "2026-07-26-local",
      "allowed_routes": [
        "stage",
        "ast",
        "current_source",
        "docs",
        "canonical_notebook_handoff",
        "fresh_authorized_production_handoff",
        "clarify_evidence_type",
        "deep_audit_handoff",
        "fail_closed_cross_project",
        "approved_one_hop_dependency",
        "bounded_fallback"
      ],
      "allowed_evidence_types": [
        "stage",
        "symbol",
        "current-source",
        "docs",
        "history",
        "ambiguous",
        "production"
      ],
      "allowed_target_kinds": [
        "stage",
        "symbol",
        "docs",
        "source",
        "artifact"
      ],
      "allowed_phases": [
        "shadow"
