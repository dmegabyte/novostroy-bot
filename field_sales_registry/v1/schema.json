{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novostroy.local/field-sales-registry/v1/schema.json",
  "title": "External Field Sales Registry v1 module",
  "type": "object",
  "required": ["module", "cards"],
  "additionalProperties": false,
  "properties": {
    "module": {"type": "string", "pattern": "^[a-z_]+$"},
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/card"}
    }
  },
  "$defs": {
    "scenario": {"enum": ["family", "commute", "budget", "comfort", "safety", "investment", "parking", "readiness", "general"]},
    "strength": {"enum": ["strong", "supporting", "neutral", "weak"]},
    "freshness": {
      "type": "object",
      "required": ["policy", "cache_static", "reason"],
      "additionalProperties": false,
      "properties": {
        "policy": {"enum": ["static_until_mcp_changes", "dynamic_mcp_required"]},
        "cache_static": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "angle": {
      "type": "object",
      "required": ["scenario", "benefit", "strength", "requires_all", "requires_any", "do_not_say"],
      "additionalProperties": false,
      "properties": {
        "scenario": {"$ref": "#/$defs/scenario"},
        "benefit": {"type": "string", "minLength": 1},
        "strength": {"$ref": "#/$defs/strength"},
        "requires_all": {"type": "array", "items": {"type": "string"}},
        "requires_any": {"type": "array", "items": {"type": "string"}},
        "do_not_say": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "card": {
      "type": "object",
      "required": ["field_id", "domain", "source_fields", "canonical_fact", "client_label", "value_type", "literal_meaning", "sales_strength", "freshness", "required_evidence", "scenario_angles", "combines_with", "forbidden_claims", "rendering_rules"],
      "additionalProperties": false,
      "properties": {
        "field_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "domain": {"type": "string", "pattern": "^[a-z_]+$"},
        "source_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "canonical_fact": {"type": "string", "minLength": 1},
        "client_label": {"type": "string", "minLength": 1},
        "value_type": {"enum": ["text", "number", "money", "boolean", "list", "area", "floor", "link", "inventory", "percentage", "months"]},
        "literal_meaning": {"type": "string", "minLength": 1},
        "sales_strength": {"$ref": "#/$defs/strength"},
        "freshness": {"$ref": "#/$defs/freshness"},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "scenario_angles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/angle"}},
        "combines_with": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rendering_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
