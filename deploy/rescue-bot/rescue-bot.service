[Unit]
Description=Telegram Rescue Bot for VPS recovery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/neiro/rescue-bot
EnvironmentFile=/home/neiro/rescue-bot/rescue-bot.env
ExecStart=/usr/bin/python3 /home/neiro/rescue-bot/rescue_bot.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=default.target
