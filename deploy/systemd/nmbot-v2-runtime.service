[Unit]
Description=NMBot isolated V2 runtime shell
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/neiro/novostroy-bot-v2/current
EnvironmentFile=/home/neiro/novostroy-bot-v2/.env
Environment=PYTHONPATH=/home/neiro/novostroy-bot-v2/current
ExecStartPre=/bin/mkdir -p /home/neiro/novostroy-bot-v2/data /home/neiro/novostroy-bot-v2/logs
ExecStart=/usr/bin/python3 /home/neiro/novostroy-bot-v2/current/scripts/nmbot_v2_service.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
