    "V2": {"endpoint_env": "NMBOT_V2_INTERNAL_ENDPOINT", "token_env": "NMBOT_V2_INTERNAL_TOKEN", "state_owner": "nmbot_v2", "log_owner": "nmbot_v2", "release_owner": "nmbot_v2"},
    "V3": {"endpoint_env": "NMBOT_V3_INTERNAL_ENDPOINT", "token_env": "NMBOT_V3_INTERNAL_TOKEN", "state_owner": "nmbot_v3", "log_owner": "nmbot_v3", "release_owner": "nmbot_v3"}
  }
